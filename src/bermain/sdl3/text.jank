(ns bermain.sdl3.text
  (:include
   "SDL3_ttf/SDL_ttf.h")
  (:require
   [bermain.engine.world :as world]
   [bermain.sdl3.error :refer [must-be-some must-be-true]]
   [bermain.sdl3.time :as time]))

;; resource
;; https://github.com/libsdl-org/SDL_ttf/blob/main/examples/showfps.c

(defn init [game]
  (must-be-true (cpp/TTF_Init))

  (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) (:sdl-renderer-box game))
        engine   (must-be-some (cpp/TTF_CreateRendererTextEngine renderer))
        font     (doto (must-be-some (cpp/TTF_OpenFont "res/fonts/CardboardCrown/CardboardCrown.ttf" 32))
                   (cpp/TTF_SetFontSize 24.0))
        text     (must-be-some (cpp/TTF_CreateText engine font "empty" 0))]
    (assoc game
           ::engine (cpp/box engine)
           ::font   (cpp/box font)
           ::text   (cpp/box text))))

(defn render! [_game])

(defn clean! [{:keys [::text ::engine ::font]}]
  (when text (cpp/TTF_DestroyText (cpp/unbox (:* cpp/TTF_Text) text)))
  (when engine (cpp/TTF_DestroyRendererTextEngine (cpp/unbox (:* cpp/TTF_TextEngine) engine)))
  (when font (cpp/TTF_CloseFont (cpp/unbox (:* cpp/TTF_Font) font)))
  (cpp/TTF_Quit))
