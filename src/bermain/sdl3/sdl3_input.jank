(ns bermain.sdl3.sdl3-input
  (:include "SDL3/SDL.h"))

(def keyname->scancode
  {::esc   cpp/SDL_SCANCODE_ESCAPE
   ::a     cpp/SDL_SCANCODE_A
   ::d     cpp/SDL_SCANCODE_D
   ::space cpp/SDL_SCANCODE_SPACE})

(defn process-mouse [{{main-scale :main-scale} :windows :as game}]
  (let [mouse-x      (cpp/float)
        mouse-y      (cpp/float)
        button-flags (cpp/SDL_GetMouseState (cpp/& mouse-x) (cpp/& mouse-y))
        mouse-x      (/ mouse-x main-scale)
        mouse-y      (/ mouse-y main-scale)]
    (update game :mouse assoc
            :button-flags button-flags
            :mouse-x mouse-x
            :mouse-y mouse-y)))

(defn process-input [{:keys [kb-state-box] :as prev-game}]
  (let [kb-state (cpp/unbox (:* (:const cpp/bool)) kb-state-box)
        game     (assoc prev-game ::pressed? #{})]
    (reduce-kv
     (fn [game' keyname scancode]
       (if (cpp/aget kb-state (cpp/int scancode))
         (update game ::pressed? conj keyname)
         game'))
     game keyname->scancode)))

(defn poll-events [game]
  (let [event (cpp/SDL_Event)]
    (loop [game' game]
      (if (cpp/SDL_PollEvent (cpp/& event))
        ;; from https://wiki.libsdl.org/SDL3/SDL_Event
        ;; Uint32 type; /**< Event type, shared with all events, Uint32 to cover user events which are not in the SDL_EventType enumeration */
        (let [event-type (cpp/unsafe-cast cpp/SDL_EventType (.-type event))]
          (cond
            (or (cpp/== event-type cpp/SDL_EVENT_QUIT)
                (-> game ::pressed? ::esc)
                (cpp/== event-type cpp/SDL_EVENT_WINDOW_CLOSE_REQUESTED))
            (recur (assoc game' :end? true))

            (cpp/== event-type cpp/SDL_EVENT_MOUSE_BUTTON_DOWN)
            (recur (assoc-in game' [:mouse :mouse-down?] true))

            (cpp/== event-type cpp/SDL_EVENT_MOUSE_BUTTON_UP)
            (recur (assoc-in game' [:mouse :mouse-down?] false))

            :else (recur game')))
        (-> game'
            (process-input)
            (process-mouse))))))
