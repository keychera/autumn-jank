(ns bermain.sdl3.sdl3
  (:require
   [bermain.engine.world :as world]
   [odoyle.rules :as o]))

(def rules
  (o/ruleset
   {::sdl3-root
    [:what [:root ::renderer sdl-renderer]]}))

(defn world-init [world {:keys [sdl-renderer]}]
  (o/insert world :root ::renderer sdl-renderer))

(defn init [game]
  (world/establish game rules world-init))
