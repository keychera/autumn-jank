(ns bermain.sdl3.audio
  (:include
   "SDL3_mixer/SDL_mixer.h")
  (:require
   [bermain.engine.fact-queue :refer [queue-new-fact!]]
   [bermain.engine.utils :refer [s->]]
   [bermain.engine.world :as world]
   [bermain.sdl3.error :refer [must-be-some must-be-true]]
   [odoyle.rules :as o]))

(defn playing? [^(:* cpp/MIX_Track) track]
  (cpp/MIX_TrackPlaying track))

(defn set-track [^(:* cpp/MIX_Track) track ^(:* cpp/MIX_Audio) audio]
  (cpp/MIX_SetTrackAudio track audio))

(defn play [^(:* cpp/MIX_Track) track]
  (cpp/MIX_PlayTrack track 0))

(def audio-atom (atom {}))

(def rules
  (o/ruleset
   {::load-audio
    [:what
     [:root ::mixer-box mixer-box]
     [esse-id ::audio-path audio-path]
     :then
     (println "load-audio" esse-id audio-path)
     (future
       (let [mixer (cpp/unbox (:* cpp/MIX_Mixer) mixer-box)
             audio (must-be-some (cpp/MIX_LoadAudio mixer audio-path true))]
         (swap! audio-atom assoc esse-id {:audio (cpp/box audio)})
         (queue-new-fact! [esse-id ::loaded? true])))
     (s-> session (o/retract esse-id ::audio-path))]

    ::play-bgm
    [:what
     [:root ::mixer-box mixer-box]
     [esse-id ::loaded? true]
     [esse-id ::bgm? true]
     :then
     (let [mixer     (cpp/unbox (:* cpp/MIX_Mixer) mixer-box)
           bgm       (:audio (get @audio-atom esse-id))
           bgm-track (cpp/box (must-be-some (cpp/MIX_CreateTrack mixer)))]
       (set-track bgm-track bgm)
       (play bgm-track))]}))

(defn world-init [world {:keys [mixer-box]}]
  (-> world
      (o/insert :root ::mixer-box mixer-box)
      (o/insert :bgm-a {::audio-path "res/pixelspheremegamix.ogg"
                        ::bgm? true})))

(defn init [game]
  (must-be-true (cpp/MIX_Init))

  (let [mixer (must-be-some (cpp/MIX_CreateMixerDevice cpp/SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK cpp/nullptr))]
    (-> (assoc game :mixer-box (cpp/box mixer))
        (world/establish rules world-init))))

(defn flow
  [game]
  game)

(defn clean! [_game]
  (cpp/MIX_Quit)
  (reset! audio-atom {}))
