(ns bermain.sdl3.image
  (:include
   "SDL3/SDL.h"
   "SDL3_image/SDL_image.h")
  (:require
   [bermain.engine.fact-queue :refer [queue-new-fact!]]
   [bermain.engine.utils :refer [s->]]
   [bermain.engine.world :as world]
   [bermain.sdl3.error :refer [must-be-some]]
   [bermain.sdl3.sdl3 :as sdl3]
   [odoyle.rules :as o]))

(defonce textures-atom (atom {}))

(def rules
  (o/ruleset
   {::load-image
    [:what
     [:root ::sdl3/renderer-box sdl-renderer-box]
     [esse-id ::image-path image-path]
     :then
     (println "load-image" esse-id)
     (future
       (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) sdl-renderer-box)
             texture  (doto (must-be-some (cpp/IMG_LoadTexture renderer image-path))
                        (cpp/SDL_SetTextureScaleMode cpp/SDL_SCALEMODE_NEAREST))]
         (swap! textures-atom assoc esse-id (cpp/box texture))
         (queue-new-fact! [esse-id ::loaded? true])))
     (s-> session (o/retract esse-id ::image-path))]

    ::loaded-images
    [:what
     [esse-id ::loaded? true]
     [esse-id ::world/pos2d pos2d]]}))

(defn world-init [world _game]
  (-> world
      (o/insert :carmine {::image-path "res/images/carmine.PNG"
                          ::world/pos2d {:x 30.0 :y 50.0}})
      (o/insert :conveyor {::image-path "res/images/conveyor.PNG"
                           ::world/pos2d {:x 0.0 :y 320.0}})))

(defn init [game]
  (world/establish game rules world-init))

(defn render! [game]
  (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) (:sdl-renderer game))]
    (doseq [{:keys [esse-id] {:keys [x y]} :pos2d} (world/ask-many game ::loaded-images)]
      (when-let [texture-box (get @textures-atom esse-id)]
        (let [texture  (cpp/unbox (:* cpp/SDL_Texture) texture-box)
              src-rect (cpp/SDL_FRect 0.0 0.0 (.-w texture) (.-h texture))
              dst-rest (cpp/SDL_FRect x y (.-w texture) (.-h texture))]
          (cpp/SDL_RenderTexture renderer texture (cpp/& src-rect) (cpp/& dst-rest)))))))

(defn clean! [_game]
  (doseq [[_ texture] @textures-atom]
    (cpp/SDL_DestroyTexture (cpp/unbox (:* cpp/SDL_Texture) texture)))
  (reset! textures-atom {}))

(comment
  (require '[bermain.engine.world-mutator :refer [inject-facts!]])

  (inject-facts!
   [:carmine {::world/pos2d {:x 30.0 :y 50.0}}]
   [:conveyor {::world/pos2d {:x 0.0 :y 320.0}}])

  :-)
