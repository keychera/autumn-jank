(ns bermain.engine.world-mutator
  (:require
   [bermain.engine.world :as world]
   [odoyle.rules :as o]))

(defn put-into-debug-tap [x]
  #_{:clj-kondo/ignore [:inline-def]}
  (def debug-tap x))

(defonce world-mutator
  (do (add-tap put-into-debug-tap)
      (atom nil)))

(defn mutate-world! [mutate-fn]
  ;; this is not swap! by design!
  ;;  it supposed to hold an (fn [world] world)
  ;; then the atom will be polled by ::world-mutator and consumed once
  (reset! world-mutator mutate-fn))

(defn inject-facts! [& facts]
  (mutate-world!
   (fn [world]
     (reduce (fn [w [id attr->value]] (o/insert w id attr->value))
             world facts)))
  (str "inserted " (count (into [] (mapcat second) facts)) " fact(s)"))

(defn flow [game]
  (if-let [mutator-fn @world-mutator]
    (do (reset! world-mutator nil)
        (update game ::world/this mutator-fn))
    game))

(comment

  debug-tap

  :-)
