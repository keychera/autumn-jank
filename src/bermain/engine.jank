(ns bermain.engine
  (:require
   [bermain.engine.fact-queue :as fact-queue]
   [bermain.engine.world :as world]
   [bermain.engine.world-mutator :as world-mutator]
   [bermain.sdl3.audio :as audio]
   [bermain.sdl3.error :as error]
   [bermain.sdl3.image :as image]
   [bermain.sdl3.sdl3 :as sdl3]
   [bermain.sdl3.sdl3-input :as sdl3-input]
   [bermain.sdl3.text :as text]
   [bermain.sdl3.time :as time]))

(defn init [game]
  (-> game
      (time/init)
      (sdl3/init)
      (audio/init)
      (text/init)
      (image/init)

      (#_dev-only world-mutator/init)
      (world/init)))

(defn tick [game]
  (-> game
      (sdl3-input/poll-events)
      (fact-queue/flow)
      (world/tick)
      (time/flow)
      (audio/flow)))

(defn render! [game]
  (image/render! game)
  (text/render! game))

(defn clean! [game]
  (doto game
    (image/clean!)
    (text/clean!)
    (audio/clean!)
    (error/clean!)))
