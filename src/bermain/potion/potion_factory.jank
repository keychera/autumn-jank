(ns bermain.potion.potion-factory
  (:include
   "SDL3/SDL.h"
   "SDL3_ttf/SDL_ttf.h"
   "extra.hpp"
   "choreograph/Choreograph.h"
   "choreograph/Easing.h")
  (:require
   [bermain.engine.anime :as anime]
   [bermain.engine.utils :as utils :refer [s->]]
   [bermain.engine.world :as world]
   [bermain.esse :as esse]
   [bermain.sdl3.image :as image]
   [bermain.sdl3.sdl3-input :as input]
   [bermain.sdl3.text :as text]
   [bermain.sdl3.time :as time]
   [odoyle.rules :as o]))

#_[float float]
(defn box-vec2 [x y] (cpp/box (cpp/new cpp/vec2 x y)))
#_::esse/vec2-box

(def deposit-line 530.0)

;; https://prideout.net/blog/par_streamlines/#basic-usage
(cpp/raw
 "parsl_position square_vertices[] = {
    {50, 150}, {200, 100},
    {400, 200}, {400, 100}
};
  
  uint16_t spine_lengths[] = { 4 };

  parsl_context* create_sl_context(int thickness) {
    parsl_context* sl_context = parsl_create_context({ .thickness = thickness });
    return sl_context;
}")

(defn clean! [{:keys [::sl-context-box]}]
  (let [sl-context (cpp/unbox (:* cpp/parsl_context) sl-context-box)]
    (cpp/parsl_destroy_context sl-context)))

(defn route-inputs [{pressed? ::input/pressed? :as game}]
  (cond-> game
    (::input/space pressed?)
    (world/insert-fact :root {::put-on-conveyor-belt true})))

(defn flow [{main-scale :main-scale :as game}]
  (let [mouse-x (cpp/float)
        mouse-y (cpp/float)]
    (cpp/SDL_GetMouseState (cpp/& mouse-x) (cpp/& mouse-y))
    (let [mouse-x (/ mouse-x main-scale)
          mouse-y (/ mouse-y main-scale)]
      (-> (assoc game :mouse-x mouse-x :mouse-y mouse-y)
          (world/insert-fact :root {::mouse (select-keys game [:mouse-down? :mouse-x :mouse-y])})
          (route-inputs)))))

(defn inside? [px py area-x area-y area-w area-h]
  (and px py (< area-x px (+ area-x area-w))
       (< area-y py (+ area-y area-h))))

(defn world-init [world _game]
  (-> (reduce-kv
       (fn [world esse-id image-path]
         (o/insert world esse-id ::image/image-path image-path))
       world {:carmine-img "res/images/carmine.PNG"
              :conveyor-img "res/images/conveyor.PNG"
              :potion1-img "res/images/potion1.PNG"
              :potion2-img "res/images/potion2.PNG"
              :potion1NG-img "res/images/potion1NG.PNG"
              :potion2NG-img "res/images/potion2NG.PNG"})
      (o/insert :carmine {::image/use :carmine-img
                          ::esse/vec2-box (box-vec2 30.0 50.0)
                          ::layer 0})
      (o/insert :conveyor {::image/use :conveyor-img
                           ::esse/vec2-box (box-vec2 0.0 320.0)
                           ::layer 0})
      (o/insert :potion1 {::image/use :potion1-img
                          ::esse/vec2-box (box-vec2 30.0 335.0)
                          ::potion-state ::on-conveyor
                          ::kind ::potion})
      (o/insert :potion2 {::image/use :potion2-img
                          ::esse/vec2-box (box-vec2 160.0 335.0)
                          ::potion-state ::on-conveyor
                          ::kind ::potion})))

(def rules
  (o/ruleset
   {::put-on-conveyor-belt
    [:what
     [:root ::put-on-conveyor-belt true]
     :then
     (let [potion-id (keyword (str "potion" (random-uuid)))
           potions [:potion1-img :potion2-img :potion1NG-img :potion2NG-img]
           rand-y  [-20 0 20]]
       (s-> session
            (o/insert potion-id {::image/use (rand-nth potions)
                                 ::esse/vec2-box (cpp/box (cpp/new cpp/vec2 -20.0 (+ 335.0 (rand-nth rand-y))))
                                 ::potion-state ::on-conveyor
                                 ::kind ::potion})))]

    ::images-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::layer layer]]

    ::potions-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::kind ::potion]
     [image-id ::image/metadata metadata]
     :then-finally
     (let [all-potions (o/query-all session ::potions-to-render)]
       (s-> session (o/insert :root ::all-potions all-potions)))]

    ::potions-under-mouse
    [:what
     [:root ::all-potions all-potions]
     [:root ::mouse mouse]
     :then
     (let [{:keys [mouse-x mouse-y]} mouse
           mouse-xf (comp
                     (map (fn [{:keys [vec2-box esse-id]
                                {:keys [width height]} :metadata}]
                            (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
                              {:esse-id esse-id :x (.-x vec2) :y (.-y vec2) :w width :h height})))
                     (filter (fn [{:keys [x y w h]}]
                               (inside? mouse-x mouse-y x y w h)))
                     (take 1))
           hit-by-mouse (first (into [] mouse-xf all-potions))]
       (s-> session
            (o/insert :root {::hit-by-mouse hit-by-mouse
                             ::target-esse-id (:esse-id hit-by-mouse)})))]

    ::hit-by-mouse
    [:what
     [:root ::hit-by-mouse hit-by-mouse]]

    ::throw
    [:what
     [:root ::mouse mouse]
     [:root ::target-esse-id esse-id]
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :when (:mouse-down? mouse)
     :then
     (let [vec2          (cpp/unbox (:* cpp/vec2) vec2-box)
           deposit-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
           rand-val      [-50 -40 30 0 30 40 50]]
       (doto (cpp/* deposit-anime)
         (cpp/thenRampTo (cpp/vec2 (float (+ 630 (rand-nth rand-val)))
                                   (float (+ 228 (rand-nth rand-val)))) 1.0 (cpp/choreograph.EaseOutQuint))
         (cpp/thenRampTo (cpp/vec2 630 500) 0.2))
       (s-> session
            (o/retract esse-id ::potion-state)
            (o/insert esse-id {::Sequence-box (cpp/box deposit-anime)})))]

    ::conveyor-belt
    [:what
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (anime/play-episode! esse-id
       (fn [game dt]
         (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
           (if (< (.-x vec2) deposit-line)
             (do (cpp/+= (.-x vec2) (* 74.0 dt)) game)
             (let [vec2          (cpp/unbox (:* cpp/vec2) vec2-box)
                   deposit-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
                   rand-val      [-50 -40 30 0 30 40 50]]
               (doto (cpp/* deposit-anime)
                 (cpp/thenRampTo (cpp/vec2 (float (+ 630 (rand-nth rand-val)))
                                           (float (+ 228 (rand-nth rand-val)))) 1.0 (cpp/choreograph.EaseOutQuint))
                 (cpp/thenRampTo (cpp/vec2 630 500) 0.2))
               (-> game
                   (world/retract-many esse-id [::potion-state])
                   (world/insert-fact esse-id {::Sequence-box (cpp/box deposit-anime)})))))))]

    ::vec2+Sequence
    [:what
     [esse-id ::kind ::potion]
     [esse-id ::Sequence-box Sequence-box]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (anime/play-episode! esse-id
       (fn [game dt]
         (let [vec2       (cpp/unbox (:* cpp/vec2) vec2-box)
               choreo-seq (cpp/unbox (:* (choreograph.Sequence cpp/vec2)) Sequence-box)
               anime-time (get-in game [esse-id ::time] 0.0)]
           (if (< anime-time (.getDuration (cpp/* choreo-seq)))
             (let [vec2' (.getValue (cpp/* choreo-seq) anime-time)]
               (cpp/= (.-x vec2) (.-x vec2'))
               (cpp/= (.-y vec2) (.-y vec2'))
               (assoc-in game [esse-id ::time] (+ anime-time dt)))
             (-> game
                 (world/retract-many esse-id [::image/use ::kind ::Sequence-box ::esse/vec2-box])
                 (anime/end-episode esse-id))))))]}))

(defn init [game]
  (let [sl-context (cpp/create_sl_context 5)]
    (-> (assoc game ::sl-context-box (cpp/box sl-context))
        (world/establish rules world-init))))

(defn render-this
  [^(:* cpp/SDL_Renderer) sdl-renderer
   {:keys [image-id vec2-box]}]
  (when-let [texture-box (get @image/textures-atom image-id)]
    (let [vec2     (cpp/unbox (:* cpp/vec2) vec2-box)
          texture  (cpp/unbox (:* cpp/SDL_Texture) texture-box)
          src-rect (cpp/SDL_FRect 0.0 0.0 (.-w texture) (.-h texture))
          dst-rest (cpp/SDL_FRect (.-x vec2) (.-y vec2) (.-w texture) (.-h texture))]
      (cpp/SDL_RenderTexture sdl-renderer texture (cpp/& src-rect) (cpp/& dst-rest)))))

(defn render!
  [{sdl-renderer-box :sdl-renderer-box
    sl-context-box ::sl-context-box
    text-box ::text/text
    :as game}]
  (let [renderer     (cpp/unbox (:* cpp/SDL_Renderer) sdl-renderer-box)
        text         (cpp/unbox (:* cpp/TTF_Text) text-box)
        sl-context   (cpp/unbox (:* cpp/parsl_context) sl-context-box)
        hit-by-mouse (:hit-by-mouse (world/ask-one game ::hit-by-mouse))
        potions (->> (world/ask-many game ::potions-to-render)
                     (sort-by (fn [{vec2-box :vec2-box}]
                                (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
                                  (.-y vec2))) >))]

    (tap> (::world/this game))

    (let [images (world/ask-many game ::images-to-render)]
      (doseq [image images]
        (render-this sdl-renderer-box image)))

    (doseq [potion potions]
      (render-this sdl-renderer-box potion))

    (when hit-by-mouse ;; draw box around it
      (let [{:keys [x y w h]} hit-by-mouse
            _ (do
                (cpp/= (.-x (cpp/aget cpp/square_vertices 0)) x)
                (cpp/= (.-y (cpp/aget cpp/square_vertices 0)) y)
                (cpp/= (.-x (cpp/aget cpp/square_vertices 1)) (+ x w))
                (cpp/= (.-y (cpp/aget cpp/square_vertices 1)) y)
                (cpp/= (.-x (cpp/aget cpp/square_vertices 2)) (+ x w))
                (cpp/= (.-y (cpp/aget cpp/square_vertices 2)) (+ y h))
                (cpp/= (.-x (cpp/aget cpp/square_vertices 3)) x)
                (cpp/= (.-y (cpp/aget cpp/square_vertices 3)) (+ y h)))
            mesh (cpp/parsl_mesh_from_lines
                  sl-context
                  (cpp/parsl_spine_list
                   #_num_vertices 4
                   #_num_spines 1
                   #_vertices cpp/square_vertices
                   #_spine_lengths cpp/spine_lengths
                   #_closed true))]
        (cpp/SDL_SetRenderDrawColor renderer 225 215 25 cpp/SDL_ALPHA_OPAQUE)
        (let [vertices (cpp/parsl_mesh_to_SDL_Vertices mesh)
              indices  (cpp/parsl_mesh_to_indices mesh)]
          (cpp/SDL_RenderGeometry renderer cpp/nullptr (.data vertices) (.size vertices) (.data indices) (.size indices)))))

    ;; debug
    (let [{:keys [mouse-x mouse-y mouse-down?]} game
          debug-fps (::time/debug-fps game 0)
          num-of-potions (count potions)]
      (doto text
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str
                                debug-fps "\n"
                                "hit: " hit-by-mouse "\n"
                                "mouse-down: " mouse-down? "\n"
                                (format "{:.2f}" mouse-x)
                                ", "
                                (format "{:.2f}" mouse-y)
                                "\npotions:" num-of-potions) 0)
        (cpp/TTF_DrawRendererText 16.0 8.0))

      (cpp/SDL_SetRenderDrawColor renderer 0 0 0 255)
      (cpp/SDL_RenderLine renderer deposit-line 0.0 deposit-line 600.0))))

(comment
  (require '[bermain.engine.world-mutator :refer [inject-facts! debug-tap]])

  debug-tap

  (count (o/query-all debug-tap))
  (doseq [fact (o/query-all debug-tap)]
    (println fact))

  (inject-facts!
   [:root {::put-on-conveyor-belt true}])

  :-)
