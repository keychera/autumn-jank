(ns bermain.potion.potion-factory
  (:include
   "SDL3/SDL.h"
   "SDL3_ttf/SDL_ttf.h"
   "extra.hpp"
   "choreograph/Choreograph.h"
   "choreograph/Easing.h")
  (:require
   [bermain.engine.anime :as anime]
   [bermain.engine.input :as input]
   [bermain.engine.utils :as utils :refer [s-> insert-facts]]
   [bermain.engine.world :as world]
   [bermain.esse :as esse :refer [box-vec2]]
   [bermain.sdl3.image :as image]
   [bermain.sdl3.sdl3-input :as sdl3-input]
   [bermain.sdl3.text :as text]
   [bermain.sdl3.time :as time]
   [odoyle.rules :as o]
   [bermain.engine.hitbox :as hitbox]))

(def deposit-line 530.0)

(defn route-inputs [{pressed? ::sdl3-input/pressed? :as game}]
  (cond-> game
    (::sdl3-input/space pressed?)
    (world/insert-fact :root {::put-on-conveyor-belt true})))

(defn flow [game]
  (-> game
      (route-inputs)))

(defn inside? [px py area-x area-y area-w area-h]
  (and px py (< area-x px (+ area-x area-w))
       (< area-y py (+ area-y area-h))))

(def ui-OK-x 400.0)
(def ui-OK-y 20.0)
(def ui-NG-dist 180.0)
(defonce judgement (atom {:OK 0 :NG 0}))

(defn default-metadata->areas [{:keys [width height]}]
  [[0.0 0.0 (float width) (float height)]])

(defn world-init [world _game]
  (reset! judgement {:OK 0 :NG 0})
  (-> (reduce-kv
       (fn [world image-id {:keys [image-path areas-fn]}]
         (o/insert world image-id (cond-> {::image/image-path image-path}
                                    areas-fn (assoc ::areas-fn areas-fn))))
       world {:count-OK {:image-path "res/images/countOK.PNG"}
              :count-NG {:image-path "res/images/countNG.PNG"}
              :carmine-img {:image-path "res/images/carmine.PNG"}
              :conveyor-img {:image-path "res/images/conveyor.PNG"}
              :potion1-img {:image-path "res/images/potion1.PNG"
                            :areas-fn (fn [{:keys [width height]}]
                                        (let [width    (float width)
                                              height-1 (float (/ height 1.8))
                                              height-2 (- height height-1)
                                              height-3 (/ height-2 2)
                                              height-4 (+ height-1 height-3)]
                                          [[30.0 0.0 30.0 height-1]
                                           [20.0 height-1 60.0 height-3]
                                           [0.0 height-4 width height-3]]))}
              :potion2-img {:image-path "res/images/potion2.PNG" :areas-fn default-metadata->areas}
              :potion1NG-img {:image-path "res/images/potion1NG.PNG"
                              :areas-fn (fn [{:keys [width height]}]
                                          (let [width    (float width)
                                                height-1 (float (/ height 2.5))
                                                height-2 (- height height-1)
                                                height-3 (/ height-2 2)
                                                height-4 (+ height-1 height-3)]
                                            [[30.0 0.0 30.0 height-1]
                                             [20.0 height-1 60.0 height-3]
                                             [0.0 height-4 width height-3]]))}
              :potion2NG-img {:image-path "res/images/potion2NG.PNG" :areas-fn default-metadata->areas}})
      (insert-facts
       [:count-OK {::image/use :count-OK
                   ::esse/vec2-box (box-vec2 ui-OK-x ui-OK-y)
                   ::layer 0}]
       [:count-NG {::image/use :count-NG
                   ::esse/vec2-box (box-vec2 (+ ui-OK-x ui-NG-dist) ui-OK-y)
                   ::layer 0}]
       [:carmine {::image/use :carmine-img
                  ::esse/vec2-box (box-vec2 30.0 50.0)
                  ::layer 0}]
       [:conveyor {::image/use :conveyor-img
                   ::esse/vec2-box (box-vec2 0.0 320.0)
                   ::layer 0}])))

(def rules
  (o/ruleset
   {::put-on-conveyor-belt
    [:what
     [:root ::put-on-conveyor-belt true]
     :then
     (let [potion-id (keyword (str "potion" (random-uuid)))
           potions [[:potion1-img :OK]
                    [:potion2-img :OK]
                    [:potion1NG-img :NG]
                    [:potion2NG-img :NG]]
           rand-y  [-20 0 20]
           [img quality] (rand-nth potions)]
       (s-> session
            (o/insert potion-id {::image/use img
                                 ::esse/vec2-box (box-vec2 -100.0 (+ 335.0 (rand-nth rand-y)))
                                 ::quality quality
                                 ::potion-state ::on-conveyor
                                 ::kind ::potion})))]

    ::images-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::layer layer]
     [image-id ::image/metadata metadata]]

    ::potions-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::kind ::potion]
     [image-id ::image/metadata metadata]
     :then-finally
     (let [all-potions (o/query-all session ::potions-to-render)]
       (s-> session (o/insert :root ::all-potions all-potions)))]

    ::metadata->hitboxes
    [:what
     [esse-id ::image/use image-id]
     [image-id ::areas-fn areas-fn]
     [image-id ::image/metadata metadata]
     :then
     (let [areas (areas-fn metadata)]
       (s-> session (o/insert esse-id ::hitbox/areas areas)))]

    ::throw
    [:what
     [:root ::input/mouse mouse]
     [:root ::hitbox/esse-id-hit esse-id]
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :when (:mouse-down? mouse)
     :then
     (let [vec2          (cpp/unbox (:* cpp/vec2) vec2-box)
           deposit-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
           rand-val      [-50 -40 30 0 30 40 50]]
       (doto (cpp/* deposit-anime)
         (cpp/thenRampTo (cpp/vec2 (float (+ 630 (rand-nth rand-val)))
                                   (float (+ 228 (rand-nth rand-val)))) 1.0 (cpp/choreograph.EaseOutQuint))
         (cpp/thenRampTo (cpp/vec2 630 500) 0.2))
       (s-> session
            (o/retract esse-id ::potion-state)
            (o/insert esse-id {::deposit-anime (cpp/box deposit-anime)})))]

    ::conveyor-belt
    [:what
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (anime/play-episode! esse-id
       (fn [game dt]
         (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
           (if (< (.-x vec2) deposit-line)
             (do (cpp/+= (.-x vec2) (* 74.0 dt)) game)
             (let [vec2          (cpp/unbox (:* cpp/vec2) vec2-box)
                   deposit-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
                   rand-val      [-50 -40 30 0 30 40 50]]
               (doto (cpp/* deposit-anime)
                 (cpp/thenRampTo (cpp/vec2 (float (+ 630 (rand-nth rand-val)))
                                           (float (+ 228 (rand-nth rand-val)))) 1.0 (cpp/choreograph.EaseOutQuint))
                 (cpp/thenRampTo (cpp/vec2 630 500) 0.2))
               (-> game
                   (world/retract-many esse-id [::potion-state])
                   (world/insert-fact esse-id {::deposit-anime (cpp/box deposit-anime)})))))))]

    ::deposit-anime-trigger
    [:what
     [esse-id ::kind ::potion]
     [esse-id ::quality quality]
     [esse-id ::deposit-anime deposit-anime]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (anime/play-episode! esse-id
       (fn [game dt]
         (let [vec2       (cpp/unbox (:* cpp/vec2) vec2-box)
               choreo-seq (cpp/unbox (:* (choreograph.Sequence cpp/vec2)) deposit-anime)
               anime-time (get-in game [esse-id ::time] 0.0)]
           (if (< anime-time (.getDuration (cpp/* choreo-seq)))
             (let [vec2' (.getValue (cpp/* choreo-seq) anime-time)]
               (cpp/= (.-x vec2) (.-x vec2'))
               (cpp/= (.-y vec2) (.-y vec2'))
               (assoc-in game [esse-id ::time] (+ anime-time dt)))
             (do (swap! judgement update quality + 1)
                 (-> game
                     (world/retract-many esse-id [::image/use ::quality ::kind ::deposit-anime ::esse/vec2-box])
                     (anime/end-episode esse-id)))))))]}))

(defn init [game]
  (anime/play-episode! :potion-periodic
    (fn [game dt]
      (let [potion-time (get-in game [:potion-periodic ::time] 0.0)]
        (if (< potion-time 0.5)
          (assoc-in game [:potion-periodic ::time] (+ potion-time dt))
          (-> game
              (world/insert-fact :root {::put-on-conveyor-belt true})
              (assoc-in [:potion-periodic ::time] 0.0))))))
  (-> game
      (assoc ::time/speed 1.0)
      (world/establish rules world-init)))

(defn render-this
  [^(:* cpp/SDL_Renderer) sdl-renderer
   {:keys [image-id vec2-box]}]
  (when-let [texture-box (get @image/textures-atom image-id)]
    (let [vec2     (cpp/unbox (:* cpp/vec2) vec2-box)
          texture  (cpp/unbox (:* cpp/SDL_Texture) texture-box)
          src-rect (cpp/SDL_FRect 0.0 0.0 (.-w texture) (.-h texture))
          dst-rest (cpp/SDL_FRect (.-x vec2) (.-y vec2) (.-w texture) (.-h texture))]
      (cpp/SDL_RenderTexture sdl-renderer texture (cpp/& src-rect) (cpp/& dst-rest)))))

(defn render!
  [{sdl-renderer-box :sdl-renderer-box
    text-box ::text/text
    text-ui-box ::text/text-ui
    :as game}]
  (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) sdl-renderer-box)
        text     (cpp/unbox (:* cpp/TTF_Text) text-box)
        mouse    (:mouse (world/ask-one game ::input/mouse))
        potions  (->> (world/ask-many game ::potions-to-render)
                      (sort-by (fn [{vec2-box :vec2-box}]
                                 (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
                                   (.-y vec2))) >))]

    #_(tap> (::world/this game))

    (let [text-ui (cpp/unbox (:* cpp/TTF_Text) text-ui-box)
          {:keys [OK NG]} @judgement]
      (doto text-ui
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str OK) 0)
        (cpp/TTF_DrawRendererText (+ ui-OK-x 50) ui-OK-y))
      (doto text-ui
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str NG) 0)
        (cpp/TTF_DrawRendererText (+ ui-OK-x ui-NG-dist 50) ui-OK-y)))

    (let [images (world/ask-many game ::images-to-render)]
      (doseq [image images]
        (render-this sdl-renderer-box image)))

    (doseq [potion potions]
      (render-this sdl-renderer-box potion))

    ;; debug
    (let [{:keys [mouse-x mouse-y]} mouse
          debug-fps (::time/debug-fps game 0)
          num-of-potions (count potions)]
      (doto text
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str
                                debug-fps "\n"
                                (format "{:.2f}" mouse-x)
                                ", "
                                (format "{:.2f}" mouse-y)
                                "\npotions:" num-of-potions) 0)
        (cpp/TTF_DrawRendererText 16.0 8.0))

      (cpp/SDL_SetRenderDrawColor renderer 0 0 0 255)
      (cpp/SDL_RenderLine renderer deposit-line 0.0 deposit-line 600.0))))

(comment
  (require '[bermain.engine.game-mutator :refer [inject-facts! assoc-game! debug-tap]]
           '[jank.compiler :refer [native-source]])

  (native-source '(cpp/new cpp/vec2 0.0 0.0))

  debug-tap

  (count (o/query-all debug-tap))
  (doseq [fact (o/query-all debug-tap)]
    (println fact))

  (inject-facts!
   [:potion1 {::image/use :potion1-img
              ::esse/vec2-box (box-vec2 30.0 335.0)
              ::kind ::potion}]
   [:potion2 {::image/use :potion1NG-img
              ::esse/vec2-box (box-vec2 130.0 335.0)
              ::kind ::potion}]
   [:potion3 {::image/use :potion2-img
              ::esse/vec2-box (box-vec2 230.0 335.0)
              ::kind ::potion}]
   [:potion4 {::image/use :potion2NG-img
              ::esse/vec2-box (box-vec2 330.0 335.0)
              ::kind ::potion}])

  (assoc-game! ::time/speed 0.0)

  :-)
