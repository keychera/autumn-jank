(ns bermain.potion.potion-factory
  (:include
   "SDL3/SDL.h"
   "SDL3_ttf/SDL_ttf.h"
   "extra.hpp"
   "choreograph/Choreograph.h"
   "choreograph/Easing.h")
  (:require
   [bermain.engine.anime :as anime]
   [bermain.engine.choreography :refer [apply-choreo-vec2
                                        get-choreo-vec2-duration]]
   [bermain.engine.dialogue :as dialogue]
   [bermain.engine.hitbox :as hitbox]
   [bermain.engine.input :as input]
   [bermain.engine.stage :as stage]
   [bermain.engine.utils :as utils :refer [insert-facts s->]]
   [bermain.engine.world :as world]
   [bermain.esse :as esse :refer [box-vec2]]
   [bermain.sdl3.image :as image]
   [bermain.sdl3.sdl3-input :as sdl3-input]
   [bermain.sdl3.text :as text]
   [bermain.sdl3.time :as time]
   [odoyle.rules :as o]))

(def deposit-line 530.0)
(def ui-OK-x 480.0)
(def ui-OK-y 20.0)
(def ui-NG-dist 140.0)
(defonce judgement (atom {:OK 0 :NG 0 ::story 0 :first-space false}))

(defn route-inputs [{prev-pressed? ::sdl3-input/prev-pressed?
                     pressed? ::sdl3-input/pressed? :as game}]
  (let [first-space? (and (not (:first-space @judgement))
                          (not (::sdl3-input/space prev-pressed?))
                          (::sdl3-input/space pressed?))]
    (when first-space?
      (swap! judgement assoc :first-space true))
    (cond-> game
      (::sdl3-input/space pressed?)
      (world/insert-fact :root {::put-on-conveyor-belt true})

      first-space?
      (world/insert-fact :root {::dialogue/control ::dialogue/next-dialogue})

      (and (not (::sdl3-input/p prev-pressed?)) (::sdl3-input/p pressed?))
      (update :debug? not))))

(defn flow [game]
  (-> game
      (route-inputs)))

(defn default-metadata->areas [{:keys [width height]}]
  [[0.0 0.0 (float width) (float height)]])

(def rules
  (o/ruleset
   {::put-on-conveyor-belt
    [:what
     [:root ::put-on-conveyor-belt true]
     :then
     (let [potion-id (keyword (str "potion" (random-uuid)))
           potions [[:potion1-img :OK]
                    [:potion2-img :OK]
                    [:potion1NG-img :NG]
                    [:potion2NG-img :NG]]
           rand-y  (+ 335.0 (rand-nth [-20 0 20]))
           [img quality] (rand-nth potions)]
       (s-> session
            (o/insert potion-id {::image/use img
                                 ::esse/vec2-box (box-vec2 -100.0 rand-y)
                                 ::esse/rotation 0.0
                                 ::quality quality
                                 ::potion-state ::on-conveyor
                                 ::kind ::potion})))]

    ::images-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::layer layer]
     [image-id ::image/metadata metadata]]

    ::potions-to-render
    [:what
     [esse-id ::image/use image-id]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::esse/rotation rotation]
     [esse-id ::kind ::potion]
     [image-id ::image/metadata metadata]
     :then-finally
     (let [all-potions (o/query-all session ::potions-to-render)]
       (s-> session (o/insert :root ::all-potions all-potions)))]

    ::metadata->hitboxes
    [:what
     [esse-id ::image/use image-id]
     [image-id ::areas-fn areas-fn]
     [image-id ::image/metadata metadata]
     :then
     (let [areas (areas-fn metadata)]
       (s-> session (o/insert esse-id ::hitbox/areas areas)))]

    ::conveyor-belt
    [:what
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (anime/play-episode! esse-id
       (fn [game _id dt]
         (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
           (if (< (.-x vec2) deposit-line)
             (do (cpp/+= (.-x vec2) (* 74.0 dt)) game)
             (-> game
                 (world/insert-fact esse-id {::potion-state ::depositing}))))))]

    ::considering-to-destroy
    [:what
     [:root ::input/mouse-state ::input/idle]
     [:root ::input/mouse mouse]
     [:root ::hitbox/esse-id-hit esse-id]
     [esse-id ::potion-state ::on-conveyor]
     [esse-id ::esse/vec2-box vec2-box]
     :when (:mouse-down? mouse) (input/mouse-l? mouse)
     :then
     (let [vec2           (cpp/unbox (:* cpp/vec2) vec2-box)
           floating-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))]
       (s-> session (o/insert esse-id {::original-y (.-y vec2)
                                       ::potion-state ::considering-to-destroy
                                       ::potion-health 2}))
       (doto (cpp/* floating-anime)
         (cpp/thenRampTo (cpp/vec2 (.-x vec2) 228.0) 1.0 (cpp/choreograph.EaseOutQuint))
         (cpp/thenHold (cpp/vec2 (.-x vec2) 228.0) 15.0))
       (let [floating-anime-box (cpp/box floating-anime)]
         (anime/play-episode! esse-id
           (fn [game id dt]
             (let [anime-time (get-in game [esse-id id ::time] 0.0)]
               (apply-choreo-vec2 floating-anime-box vec2-box anime-time)
               (if (< anime-time (get-choreo-vec2-duration floating-anime-box))
                 (assoc-in game [esse-id id ::time] (+ anime-time dt))
                 (-> game
                     (anime/end-episode esse-id id)
                     (world/insert-fact esse-id {::potion-state ::putting-it-back}))))))))]

    ::tapping-to-destroy
    [:what
     [:root ::input/mouse-state ::input/idle]
     [:root ::input/mouse mouse]
     [:root ::hitbox/esse-id-hit esse-id]
     [esse-id ::potion-state ::considering-to-destroy]
     [esse-id ::potion-health potion-health {:then false}]
     :when (:mouse-down? mouse) (input/mouse-l? mouse)
     :then
     (let [new-health (dec potion-health)
           rand-angle (rand-nth [-10.0 -5.0 5.0 10.0])
           session'   (o/insert session :root {::story ::next})]
       (if (> new-health 0)
         (s-> session' (o/insert esse-id {::esse/rotation rand-angle
                                          ::potion-health new-health}))
         (s-> session'
              (utils/retract-many esse-id [::potion-state ::potion-health ::image/use ::hitbox/areas ::quality ::kind ::esse/vec2-box]))))]

    ::adhoc-story
    [:what
     [:root ::story ::next]
     :then
     (let [story (::story (swap! judgement update ::story inc))]
       (when (= (mod story 8) 0)
         (s-> session (o/insert :root ::dialogue/control ::dialogue/next-dialogue))))]

    ::put-back-on-conveyor
    [:what
     [:root ::input/mouse-state ::input/idle]
     [:root ::input/mouse mouse]
     [:root ::hitbox/esse-id-hit esse-id]
     [esse-id ::potion-state ::considering-to-destroy]
     :when (:mouse-down? mouse) (input/mouse-r? mouse)
     :then
     (s-> session 
          (o/insert :root {::story ::next})
          (o/insert esse-id {::potion-state ::putting-it-back}))]

    ::put-back-on-conveyor-anime
    [:what
     [esse-id ::potion-state ::putting-it-back]
     [esse-id ::esse/vec2-box vec2-box]
     [esse-id ::original-y previous-y]
     :then
     (s-> session
          (o/retract esse-id ::original-y)
          (o/insert esse-id ::esse/rotation 0.0))
     (let [vec2            (cpp/unbox (:* cpp/vec2) vec2-box)
           returning-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
           duration        0.2]
       (doto (cpp/* returning-anime)
         (cpp/thenRampTo (cpp/vec2 (.-x vec2) previous-y) duration))
       (let [returning-anime-box (cpp/box returning-anime)]
         (anime/play-episode! esse-id
           (fn [game id dt]
             (let [anime-time (get-in game [esse-id id ::time] 0.0)]
               (apply-choreo-vec2 returning-anime-box vec2-box anime-time)
               (if (< anime-time duration)
                 (assoc-in game [esse-id id ::time] (+ anime-time dt))
                 (-> game
                     (world/insert-fact esse-id {::potion-state ::on-conveyor})
                     (anime/end-episode esse-id id))))))))]

    ::depositing
    [:what
     [esse-id ::kind ::potion]
     [esse-id ::potion-state ::depositing]
     [esse-id ::quality quality]
     [esse-id ::esse/vec2-box vec2-box]
     :then
     (let [vec2          (cpp/unbox (:* cpp/vec2) vec2-box)
           deposit-anime (cpp/new (choreograph.Sequence cpp/vec2) (cpp/* vec2))
           rand-val      [-50 -40 30 0 30 40 50]]
       (doto (cpp/* deposit-anime)
         (cpp/thenRampTo (cpp/vec2 (float (+ 630 (rand-nth rand-val)))
                                   (float (+ 228 (rand-nth rand-val)))) 1.0
                         (cpp/choreograph.EaseOutQuint))
         (cpp/thenRampTo (cpp/vec2 630 500) 0.2))
       (s-> session (o/retract esse-id ::potion-state))
       (let [deposit-anime-box (cpp/box deposit-anime)]
         (anime/play-episode! esse-id
           (fn [game id dt]
             (let [anime-time (get-in game [esse-id id ::time] 0.0)]
               (apply-choreo-vec2 deposit-anime-box vec2-box anime-time)
               (if (< anime-time (get-choreo-vec2-duration deposit-anime-box))
                 (assoc-in game [esse-id id ::time] (+ anime-time dt))
                 (do (swap! judgement update quality + 1)
                     (-> game
                         (world/retract-many esse-id [::image/use ::hitbox/areas ::quality ::kind ::esse/vec2-box])
                         (anime/end-episode esse-id id)))))))))]}))

(def carmine-play
  {:players {:ca {:name "Carmine"}
             :co {:name "Coral"}
             :tr {:name "Trixie"}}
   :effects {:funky (fn []
                      (fn [{:keys [target time]}]
                        (+ target (* 2 (cpp/sin (* 8.0 (float time)))))))}
   :scripts [[:ca "Tap 2 times to destroy the potion"]
             [:ca "The bad looking ones, I mean"]
             [:ca "You can right click to put it back"]
             [:ca "That's about it"]
             [:ca "I had a story planned"]
             [:ca "But I didn't manage to finish it"]
             [:ca "Even though I thought it was a simple idea"]
             [:ca "gamedev has a surprising amount of detail, huh?"]
             [:ca "but still..."]
             [:ca "this was a great progress"]
             [:ca "compared to my last game jam"]
             [:ca "honing my project management skills more"]
             [:ca "..."]
             [:ca "oh"]
             [:ca " you're still here?" :+]
             [:ca "thank you"]
             [:ca "try holding space"]
             [:ca [[" woah!" :funky]] :+]
             [:ca "what are you doing!"]
             [:ca "Idk if performance drop for you"]
             [:ca "can you even see this?"]
             [:ca "you can press P to toggle debug"]
             [:ca "heh"]
             [:ca ", this has been an experience" :+]
             [:ca ["a" [" janky " :funky] "experience"]]]})

(defn world-init [world _game]
  (reset! judgement {:OK 0 :NG 0 ::story 0})
  (-> (reduce-kv
       (fn [world image-id {:keys [image-path areas-fn]}]
         (o/insert world image-id (cond-> {::image/image-path image-path}
                                    areas-fn (assoc ::areas-fn areas-fn))))
       world {:count-OK {:image-path "res/images/countOK.PNG"}
              :count-NG {:image-path "res/images/countNG.PNG"}
              :carmine-img {:image-path "res/images/carmine.PNG"}
              :conveyor-img {:image-path "res/images/conveyor.PNG"}
              :potion1-img {:image-path "res/images/potion1.PNG"
                            :areas-fn (fn [{:keys [width height]}]
                                        (let [width    (float width)
                                              height-1 (float (/ height 1.8))
                                              height-2 (- height height-1)
                                              height-3 (/ height-2 2)
                                              height-4 (+ height-1 height-3)]
                                          [[30.0 0.0 30.0 height-1]
                                           [20.0 height-1 60.0 height-3]
                                           [0.0 height-4 width height-3]]))}
              :potion2-img {:image-path "res/images/potion2.PNG" :areas-fn default-metadata->areas}
              :potion1NG-img {:image-path "res/images/potion1NG.PNG"
                              :areas-fn (fn [{:keys [width height]}]
                                          (let [width    (float width)
                                                height-1 (float (/ height 2.5))
                                                height-2 (- height height-1)
                                                height-3 (/ height-2 2)
                                                height-4 (+ height-1 height-3)]
                                            [[30.0 0.0 30.0 height-1]
                                             [20.0 height-1 60.0 height-3]
                                             [0.0 height-4 width height-3]]))}
              :potion2NG-img {:image-path "res/images/potion2NG.PNG" :areas-fn default-metadata->areas}})
      (insert-facts
       [:root {::dialogue/tick-length 0.02
               ::dialogue/dialogue ""
               ::dialogue/dialogue-progress 0
               ::dialogue/play carmine-play
               ::dialogue/play-progress 0}]
       [:count-OK {::image/use :count-OK
                   ::esse/vec2-box (box-vec2 ui-OK-x ui-OK-y)
                   ::layer 0}]
       [:count-NG {::image/use :count-NG
                   ::esse/vec2-box (box-vec2 (+ ui-OK-x ui-NG-dist) ui-OK-y)
                   ::layer 0}]
       [:carmine {::image/use :carmine-img
                  ::esse/vec2-box (box-vec2 30.0 50.0)
                  ::layer 0}]
       [:conveyor {::image/use :conveyor-img
                   ::esse/vec2-box (box-vec2 0.0 320.0)
                   ::layer 0}])))

(defn init [game]
  (anime/play-episode! :potion-periodic
    (fn [game _id dt]
      (let [potion-time (get-in game [:potion-periodic ::time] 0.0)]
        (if (< potion-time 0.5)
          (assoc-in game [:potion-periodic ::time] (+ potion-time dt))
          (-> game
              (world/insert-fact :root {::put-on-conveyor-belt true})
              (assoc-in [:potion-periodic ::time] 0.0))))))
  (-> game
      (assoc ::time/speed 1.0)
      (world/establish rules world-init)))

(defn render-this
  [{sdl-renderer-box :sdl-renderer-box}
   camera
   {:keys [image-id vec2-box rotation]}]
  (when-let [texture-box (get @image/textures-atom image-id)]
    (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) sdl-renderer-box)
          [x y]    (stage/pos-on-camera camera vec2-box)
          texture  (cpp/unbox (:* cpp/SDL_Texture) texture-box)
          src-rect (cpp/SDL_FRect 0.0 0.0 (.-w texture) (.-h texture))
          dst-rest (cpp/SDL_FRect x y (.-w texture) (.-h texture))]
      (if rotation
        (cpp/SDL_RenderTextureRotated renderer texture (cpp/& src-rect) (cpp/& dst-rest) rotation cpp/nullptr cpp/SDL_FLIP_NONE)
        (cpp/SDL_RenderTexture renderer texture (cpp/& src-rect) (cpp/& dst-rest))))))

(defn render!
  [{text-ui-box ::text/text-ui
    :as game}]
  (let [camera-box (stage/get-camera-box game)
        potions  (->> (world/ask-many game ::potions-to-render)
                      (sort-by (fn [{vec2-box :vec2-box metadata :metadata}]
                                 (let [vec2 (cpp/unbox (:* cpp/vec2) vec2-box)]
                                   (+ (.-y vec2) (:height metadata))))))]

    #_(tap> (::world/this game))

    (let [text-ui (cpp/unbox (:* cpp/TTF_Text) text-ui-box)
          {:keys [OK NG]} @judgement]
      (doto text-ui
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str OK) 0)
        (cpp/TTF_DrawRendererText (+ ui-OK-x 50) ui-OK-y))
      (doto text-ui
        (cpp/TTF_SetTextColor 25 25 25 cpp/SDL_ALPHA_OPAQUE)
        (cpp/TTF_SetTextString (str NG) 0)
        (cpp/TTF_DrawRendererText (+ ui-OK-x ui-NG-dist 50) ui-OK-y)))

    (let [images (world/ask-many game ::images-to-render)]
      (doseq [image images]
        (render-this game camera-box image)))

    (doseq [potion potions]
      (render-this game camera-box potion))))

(comment
  (require '[bermain.engine.game-mutator :refer [inject-facts! assoc-game! debug-tap]]
           '[jank.compiler :refer [native-source]])

  (native-source '(cpp/new cpp/vec2 0.0 0.0))

  debug-tap

  (count (o/query-all debug-tap))
  (doseq [fact (o/query-all debug-tap)]
    (println fact))

  (inject-facts!
   [:root {::stage/camera-action {:x -0.0 :y 0.0
                                  :duration 1.0}}])

  (assoc-game! ::time/speed 0.0)

  :-)
