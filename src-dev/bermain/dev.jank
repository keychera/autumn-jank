(ns bermain.dev
  (:require
   [bermain.game :as game]))

(defonce start-atom (atom true))
(defn toggle-start []
  (if @start-atom
    (println "already started!")
    (do (reset! start-atom true)
        "starting game!")))

(defn dev []
  (while true
    (try
      (when @start-atom
        (#'game/-main)
        (reset! start-atom false))
      (catch :default _
        (println "error!")
        (reset! start-atom false)))))

(defonce _ (dev))

(comment
  (toggle-start)

  ::waiting-for-something-to-happen?)
