(ns bermain.dev
  (:require
   [bermain.game :as game]))

(defonce start-atom (atom true))
(defn start []
  (if @start-atom
    (println "already started!")
    (do (reset! start-atom true)
        "starting game!")))

(defn dev []
  (future
    (while true
      (try
        (when @start-atom
          (#'game/-main)
          (reset! start-atom false))
        (catch cpp/jank.runtime.object_ref e
          (println :caught e)
          (reset! start-atom false))))))

(defonce _ (dev))

(comment
  (start)

  ::waiting-for-something-to-happen?)
