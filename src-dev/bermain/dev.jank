(ns bermain.dev
  (:require
   [bermain.game :as game]))

(defonce stop-atom (atom false))
(defn toggle-stop []
  (if (swap! stop-atom not)
    "stopping game!"
    "starting game!"))

(defn dev []
  (future
    (while true
      (try
        (when (not @stop-atom)
          (#'game/-main {:stop-atom stop-atom})
          (reset! stop-atom true))
        (catch cpp/jank.runtime.object_ref e
          (println :caught e))))))

(defonce _ (dev))

(comment
  (toggle-stop)

  ::waiting-for-something-to-happen?)
